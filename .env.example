# Copie para .env.local e preencha. .env.local está no .gitignore.

# --- Supabase (públicas, vão para o browser) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Banco (SEGREDO — só no servidor) ---------------------------------------
#
# ATENÇÃO À SENHA: caracteres especiais precisam ser URL-encoded.
#   ?  → %3F      #  → %23      @ → %40      /  → %2F
#   :  → %3A      &  → %26      +  → %2B     espaço → %20
# Um `?` não escapado transforma o resto da string em query e a URL fica
# inválida — o driver falha antes de tentar conectar.
#
# Copie o HOST exato de Settings → Database → Connection string. A região faz
# parte dele (`sa-east-1` em São Paulo, `us-east-1` na Virgínia…).

# Runtime: pooler em modo TRANSACTION (porta 6543).
# Não acrescente `?pgbouncer=true`: é um parâmetro do Prisma. O postgres.js
# tenta enviá-lo ao servidor como configuração e a conexão é recusada.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-ENCODED@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Migrations e seed: pooler em modo SESSION (porta 5432).
# Aceita o DDL que o drizzle-kit emite e sai por IPv4. A conexão
# `db.<ref>.supabase.co:5432` também serve, mas é IPv6-only e falha na maioria
# das redes domésticas.
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA-ENCODED@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave service_role, para a administração de contas. IGNORA TODO O RLS.
# Jamais com prefixo NEXT_PUBLIC_: com ele iria para o browser e qualquer
# visitante leria e apagaria o banco inteiro.
SUPABASE_SECRET_KEY=

# Domínio das contas sem identificação. Endereço interno, nunca enviado.
# Precisa ser um domínio SEU: o Supabase recusa .invalid e .local, e um domínio
# de terceiros poderia ser registrado por alguém para receber essas mensagens.
ANON_EMAIL_DOMAIN=anon.portifoliotracker.vercel.app

# --- Operador do sistema ------------------------------------------------------
# E-mails que podem trocar o logo dos ativos. Lista separada por vírgula.
# Fora do código de propósito: o repositório pode ser público, e trocar o
# operador não deveria exigir um deploy. Sem a variável, ninguém é operador.
MASTER_EMAILS=

# --- Cotações ---------------------------------------------------------------
# CoinGecko e AwesomeAPI não pedem cadastro. BRAPI (B3) exige token gratuito
# em brapi.dev; sem ele, os ativos brasileiros ficam com preço manual.
BRAPI_TOKEN=
# Tickers por requisição. O plano gratuito aceita 1; planos pagos, mais.
BRAPI_MAX_PER_REQUEST=1

# Stocks e ETFs Internacionais: Twelve Data (twelvedata.com/register).
# Gratuito: 800 créditos/dia, 8 chamadas/minuto. O crédito é POR SÍMBOLO.
TWELVEDATA_API_KEY=
TWELVEDATA_MAX_PER_REQUEST=8

# --- Jobs (Fase 4) ----------------------------------------------------------
# Segredo do header que protege as rotas /api/jobs/*
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOBS_SECRET=
